{
  "name": "pi-small-models",
  "version": "0.1.0",
  "description": "Pi extension that disables bash and provides structured find/grep/list tools for smaller/weaker models.",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test tests/**/*.test.ts",
    "test:grep": "tsx --test tests/grep.test.ts",
    "start": "tsx index.ts",
    "lint": "eslint src/**/*.ts --ext .ts",
    "lint:fix": "eslint src/**/*.ts --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.56.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typebox": "^1.3.7"
  }
}
