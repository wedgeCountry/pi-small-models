{
  "name": "pi-small-models",
  "version": "0.1.0",
  "description": "Pi extension that disables bash and provides structured find/grep/list tools for smaller/weaker models.",
  "private": true,
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "tsx --test src/tests/**/*.test.ts",
    "test:grep": "tsx --test src/tests/grep.test.ts",
    "start": "tsx index.ts"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typebox": "^1.3.7",
    "typescript": "^5.6.0"
  }
}
